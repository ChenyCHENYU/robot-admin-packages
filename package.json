{
  "name": "robot-admin-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Robot Admin 可复用、可插拔的公共能力 Monorepo",
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChenyCHENYU/robot-admin-packages"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './packages/*' dev",
    "build": "node scripts/run-workspaces.mjs build",
    "test": "vitest run packages",
    "type-check": "node scripts/run-workspaces.mjs type-check",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:packages": "node scripts/run-workspaces.mjs check:package",
    "verify": "bun run check:workspace && bun run type-check && bun run test && bun run build && bun run check:packages",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "bun run verify && changeset status",
    "release": "bun run release:check && changeset publish",
    "clean": "node scripts/run-workspaces.mjs clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^6.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14"
}
