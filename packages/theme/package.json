{
  "name": "@robot-admin/theme",
  "version": "0.5.1",
  "description": "Layered theme primitives, Pinia store and Naive UI adapter for Robot Admin",
  "type": "module",
  "keywords": [
    "vue",
    "theme",
    "dark-mode",
    "design-style",
    "glassmorphism",
    "pinia",
    "view-transition"
  ],
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/robot-admin-packages.git",
    "directory": "packages/theme"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./naive": {
      "import": {
        "types": "./dist/naive.d.ts",
        "default": "./dist/naive.js"
      },
      "require": {
        "types": "./dist/naive.d.cts",
        "default": "./dist/naive.cjs"
      }
    },
    "./naive/styles": "./dist/styles/naive.css",
    "./styles/glass-morphism.css": "./dist/styles/glass-morphism.css",
    "./styles/corporate-minimal.css": "./dist/styles/corporate-minimal.css",
    "./styles/dark-tech.css": "./dist/styles/dark-tech.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && bun run build:styles",
    "build:ts": "tsup",
    "build:styles": "sass src/themes:dist/styles --style=compressed --no-source-map",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run tests",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:package": "node ./node_modules/publint/src/cli.js && node ./scripts/verify-package.mjs",
    "verify": "bun run type-check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.0.0 || ^3.0.0",
    "naive-ui": "^2.38.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "naive-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.1",
    "publint": "0.3.24",
    "sass": "^1.86.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.0",
    "vue": "^3.5.13"
  }
}
