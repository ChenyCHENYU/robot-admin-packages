{
  "name": "@robot-admin/form-validate-core",
  "version": "1.0.0",
  "description": "企业级表单验证规则库核心 - 框架无关的验证逻辑层，配合 naive-ui / element-plus adapter 使用",
  "keywords": [
    "form",
    "validation",
    "validator",
    "vue",
    "typescript",
    "form-validation",
    "framework-agnostic"
  ],
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChenyCHENYU/robot-admin-packages",
    "directory": "packages/form-validate-core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsup": "^8.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
