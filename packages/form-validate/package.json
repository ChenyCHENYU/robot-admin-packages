{
  "name": "@robot-admin/form-validate",
  "version": "3.4.2",
  "description": "企业级表单验证规则库，单包同时支持 Naive UI 与 Element Plus",
  "keywords": [
    "form",
    "validation",
    "validator",
    "naive-ui",
    "element-plus",
    "vue",
    "typescript",
    "form-validation",
    "china-locale"
  ],
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/robot-admin-packages.git",
    "directory": "packages/form-validate"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run test && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsup": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
