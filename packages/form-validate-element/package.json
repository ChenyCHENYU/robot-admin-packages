{
  "name": "@robot-admin/form-validate-element",
  "version": "1.0.1",
  "description": "企业级表单验证规则库，专为 Element Plus 设计（基于 form-validate-core，与 naive-ui 版用法完全一致）",
  "keywords": [
    "form",
    "validation",
    "validator",
    "element-plus",
    "vue",
    "typescript",
    "form-validation",
    "china-locale"
  ],
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChenyCHENYU/robot-admin-packages",
    "directory": "packages/form-validate-element"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@robot-admin/form-validate-core": "workspace:*"
  },
  "peerDependencies": {
    "element-plus": ">=2.0.0"
  },
  "devDependencies": {
    "element-plus": "^2.2.0",
    "typescript": "^5.8.0",
    "tsup": "^8.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
