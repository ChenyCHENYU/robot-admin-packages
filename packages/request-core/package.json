{
  "name": "@robot-admin/request-core",
  "version": "0.4.1",
  "description": "Instance-scoped Axios orchestration and headless CRUD composables for Vue 3",
  "type": "module",
  "keywords": [
    "vue",
    "axios",
    "crud",
    "composables",
    "request"
  ],
  "author": "ChenYu <ycyplus@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/robot-admin-packages.git",
    "directory": "packages/request-core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./axios": {
      "import": {
        "types": "./dist/axios.d.ts",
        "default": "./dist/axios.js"
      },
      "require": {
        "types": "./dist/axios.d.cts",
        "default": "./dist/axios.cjs"
      }
    },
    "./crud": {
      "import": {
        "types": "./dist/crud.d.ts",
        "default": "./dist/crud.js"
      },
      "require": {
        "types": "./dist/crud.d.cts",
        "default": "./dist/crud.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./naive": {
      "import": {
        "types": "./dist/naive.d.ts",
        "default": "./dist/naive.js"
      },
      "require": {
        "types": "./dist/naive.d.cts",
        "default": "./dist/naive.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run tests",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:package": "node ./node_modules/publint/src/cli.js && node ./scripts/verify-package.mjs",
    "verify": "bun run type-check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "naive-ui": "^2.38.0",
    "axios": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "naive-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.8.0",
    "tsup": "^8.1.0",
    "vue": "^3.4.0",
    "naive-ui": "^2.38.0",
    "axios": "^1.7.0",
    "publint": "0.3.24"
  }
}
